# Copy to services.env (git-ignored) and fill in. VARIABLE NAMES ONLY - no real values here.
# Names are taken from services/keeper/src/config.rs (KEEPER_*), services/indexer/src/main.rs, frontend/src/lib/config.ts.

# ---- shared
ARB_SEPOLIA_RPC_URL=                 # dedicated RPC (Alchemy/Infura/QuickNode); used by compose to fill the vars below
EXCHANGE_ADDRESS=                    # = "exchange" in contracts/deployments/arbitrumSepolia.json
EXCHANGE_START_BLOCK=                # = "startBlock" in the same file (deployment block)

# ---- keeper (compose forces KEEPER_DRY_RUN=true; flip only deliberately)
KEEPER_RPC_URL=                      # same as ARB_SEPOLIA_RPC_URL
KEEPER_EXCHANGE=                     # = EXCHANGE_ADDRESS
KEEPER_START_BLOCK=                  # = EXCHANGE_START_BLOCK
KEEPER_DRY_RUN=true
KEEPER_METRICS_ADDR=0.0.0.0:9102
KEEPER_STATE_FILE=/state/keeper-state.json
KEEPER_NATIVE_USD_PRICE=3000         # gas-token USD price for profitability maths (testnet ETH has no value; keep nonzero)
# ---- optional Pyth pusher (off by default; needs a Hermes endpoint that does not return 401, see docs/TESTNET_RUNBOOK.md section 6)
# KEEPER_ENABLE_PYTH_PUSH=true
# KEEPER_PYTH_CONTRACT=0x4374e5a8b9C22271E9EB878A2AA31DE97DF15DAF
# KEEPER_PYTH_FEED_IDS=BTC=0x<id>,ETH=0x<id>,SOL=0x<id>      # from infra/testnet/testnet.config.json markets[].pyth.feedId
# KEEPER_HERMES_URL=                   # default https://pyth.dourolabs.app/hermes (a URL embedding a key is never logged in full)
# HERMES_API_KEY=                      # Hermes key, sent as "Authorization: Bearer <key>" (KEEPER_HERMES_API_KEY also accepted; header/prefix: KEEPER_HERMES_API_KEY_HEADER / _PREFIX)
KEEPER_PRIVATE_KEY=                  # separate TESTNET-ONLY keeper key; NEVER the deployer key. Not needed while dry-run.
# KEEPER_MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11   # UNVERIFIED on Arbitrum Sepolia; keep multicall=auto

# ---- indexer
RPC_URL=                             # same as ARB_SEPOLIA_RPC_URL
DATABASE_URL=host=postgres user=perps password=CHANGE_ME dbname=perps_indexer   # libpq key/value form (not a postgres:// URL)
EXCHANGE=                            # = EXCHANGE_ADDRESS (or use DEPLOYMENT=/deployments/arbitrumSepolia.json)
START_BLOCK=                         # = EXCHANGE_START_BLOCK
LISTEN=0.0.0.0:8080
CORS_ORIGINS=                        # exact frontend origin(s), comma separated
POSTGRES_PASSWORD=CHANGE_ME          # compose postgres service

# ---- frontend (build-time, Next.js)
NEXT_PUBLIC_RPC_URL=                 # a browser-safe RPC URL (rate-limited key restricted by origin); public RPC ok for demos
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_INDEXER_URL=             # public URL of the indexer REST/WS
# NEXT_PUBLIC_REAL_DEPLOYMENT=       # see TESTNET_UI_PLAN.md; do NOT set to 1 unless the frontend owner confirms semantics
# frontend also reads src/generated/deployment.json (frontend/scripts/sync-deployment.mjs copies contracts/deployments/<network>.json)

# ---- deploy options (contracts/.env or shell; not secrets)
# ORACLE_MODE=chainlink              # median|chainlink; 'median' only if verify-addresses shows Pyth fresh AND a pusher runs
# DEMO_MARKET=no                     # skip the admin-priced DEMO-USD demo market
# DEMO_DEPOSIT_USDC=6                # per side, demo-backstop.js
