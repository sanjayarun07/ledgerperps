# Copy this file to `.env` (same folder) and fill in your own values.
#   cp .env.example .env
# `.env` must be git-ignored. Never commit it, never paste its contents into chat.
# Use a TESTNET-ONLY wallet. Never reuse a key that holds real funds.

# Private key of the testnet deployer wallet (0x + 64 hex characters).
# Expected address: 0x50C05D162dF2EFc2f2b9a24708bE0BcDAf8d6B29 (the scripts refuse to broadcast if it doesn't match).
DEPLOYER_PRIVATE_KEY=

# Arbitrum Sepolia RPC URL (chain id 421614). A free public endpoint is fine for light use;
# Alchemy / Infura / QuickNode are more stable.
ARB_SEPOLIA_RPC_URL=

# Optional: Etherscan v2 unified API key (create at etherscan.io > API Keys), used for source verification on Arbiscan.
ARBISCAN_API_KEY=

# Optional: a separate address to receive the GUARDIAN role (can pause markets). Leave empty to skip.
GUARDIAN_ADDRESS=

# Optional: warn if the deployer holds less than this much testnet ETH.
# MIN_DEPLOYER_ETH=0.05

# Broadcast switches. The scripts are dry-run by default; uncomment ONE at a time, only when you mean it.
# (Exact names are listed in docs/TESTNET_RUNBOOK.md once the testnet preparation is finished.)
# CONFIRM_TESTNET_DEPLOY=yes
# CONFIRM_TESTNET_SMOKE=yes
# CONFIRM_LOCK_MODULES=yes      # irreversible
# CONFIRM_TRANSFER_ADMIN=yes
# CONFIRM_PYTH_PUSH=yes          # push-pyth.js (pays a tiny Pyth update fee)
# CONFIRM_RENOUNCE_DEPLOYER=yes  # transfer-admin.js final step: deployer gives up DEFAULT_ADMIN_ROLE

# Optional overrides (names used by contracts/scripts/testnet/*):
# EXPECTED_DEPLOYER_ADDRESS=     # overrides expectedDeployer in infra/testnet/testnet.config.json
# TRADER2_PRIVATE_KEY=           # second TESTNET-ONLY key for smoke-testnet.js (else sub-account 1 of the deployer is used)
# USE_MOCK_USDC=yes              # deploy-testnet.js: deploy MockUSDC faucet token instead of using Circle test USDC
# SMOKE_MARKET=0                 # 0=BTC-USD 1=ETH-USD 2=SOL-USD
# SMOKE_DEPOSIT_USDC=5
# SMOKE_PUSH_PYTH=yes            # smoke-testnet.js pushes a Hermes price update first
# HERMES_URL=https://hermes.pyth.network
# TIMELOCK_MIN_DELAY=3600        # transfer-admin.js
# PROPOSERS=0x..,0x..            # transfer-admin.js (comma separated)
# EXECUTORS=0x..                 # transfer-admin.js (default = PROPOSERS)
# TIMELOCK_ADDRESS=              # transfer-admin.js: reuse an existing timelock
# VERIFY_DRY=1                   # verify-contracts.js: preview only
